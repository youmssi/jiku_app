{
  "invitation_v1": {
    "parameters": [
      "guestName",
      "organizerName",
      "eventName",
      "eventWhen",
      "invitationUrl"
    ],
    "fr": [
      {
        "type": "BODY",
        "text": "Bonjour {{1}},\n\n{{2}} vous invite à {{3}}, {{4}}, et vous envoie cette invitation par Jikū.\n\nConfirmez votre présence en ouvrant ce lien : {{5}}\n\nMerci et à bientôt !",
        "example": {
          "body_text": [
            [
              "Awa",
              "Famille Diallo",
              "Mariage d'Awa et Moussa",
              "samedi 12 octobre à 18 h",
              "https://jiku.app/r/AbC123"
            ]
          ]
        }
      },
      {
        "type": "FOOTER",
        "text": "Jikū · Répondez STOP pour ne plus rien recevoir"
      }
    ],
    "en": [
      {
        "type": "BODY",
        "text": "Hello {{1}},\n\n{{2}} invites you to {{3}}, {{4}}, and sends you this invitation through Jikū.\n\nConfirm whether you can come by opening this link: {{5}}\n\nThank you and see you soon!",
        "example": {
          "body_text": [
            [
              "Awa",
              "The Diallo family",
              "Awa and Moussa's wedding",
              "Saturday 12 October at 6 pm",
              "https://jiku.app/r/AbC123"
            ]
          ]
        }
      },
      {
        "type": "FOOTER",
        "text": "Jikū · Reply STOP to stop these messages"
      }
    ]
  },
