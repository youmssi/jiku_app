# ─── Jikū Backend — environment variables ────────────────────────────────────
#
# Copy this file to .env and adjust as needed. The real .env is never committed.
#
# LOCAL DEVELOPMENT: a fresh clone needs NO .env — every value below has a
# working default baked into application.yaml (Docker PostgreSQL, log-only
# mail/WhatsApp, sandbox payments).
#
# REAL DEPLOYMENTS (production, staging, on-premise): set everything in the
# REQUIRED section; the OPTIONAL section is tuning and feature toggles that are
# safe to leave at their defaults.
#
# Naming convention (following Tûm):
#   DATABASE_*     — Database connection
#   SERVER_* / CORS_* — Server & API configuration
#   AUTH_*         — Authentication & JWT
#   RATE_LIMIT_*   — Rate limiting policies
#   MAIL_*         — Email sender configuration
#   WHATSAPP_*     — WhatsApp sender configuration
#   NOTIFICATION_* — Notification delivery & reputation
#   INVITATION_*   — Guest invitations & imports
#   CHECKIN_*      — Validator links & check-in
#   BILLING_*      — Pricing, free tier & concierge payments
#   PAYMENT_*      — Payment provider (Mobile Money)
#   ADMIN_*        — Platform administration
#   COMPLIANCE_*   — Data retention policy
#   OBSERVABILITY_* — Monitoring, logging & metrics
# ──────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# REQUIRED — every real deployment must set all of these
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Full JDBC URL. Locally uses Docker PostgreSQL (port 5433 to avoid clashing
# with a host PostgreSQL on 5432). In production (Neon), append ?sslmode=require:
#   DATABASE_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech:5432/jiku?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5433/jiku
DATABASE_USERNAME=jiku
DATABASE_PASSWORD=jiku

# ─── Server & CORS ───────────────────────────────────────────────────────────
# Frontend base URL used to build guest invitation & validator check-in links.
SERVER_BASE_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API (the deployed
# frontend's origin). Defaults to http://localhost:3000 — production breaks
# without this.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Each ships only a development default; every real environment MUST set a
# strong random value.
#
# JWT HMAC signing secret, minimum 32 bytes.
# AUTH_JWT_SECRET=<at least 32 random bytes>
#
# Encrypts organizer-provided provider credentials at rest (AES-GCM), minimum
# 32 characters. Must stay stable — rotating it invalidates every stored
# tenant credential.
# PROVIDER_CREDENTIALS_ENCRYPTION_KEY=<at least 32 random characters>
#
# Shared secret for the provider bounce/complaint webhook.
NOTIFICATION_WEBHOOK_SECRET=local-development-webhook-secret
#
# Webhook secret for payment provider callbacks.
PAYMENT_WEBHOOK_SECRET=local-development-payment-webhook-secret

# ─── Mail (sender) ───────────────────────────────────────────────────────────
# Delivery transport: log (default — records sends without delivering, zero
# setup), smtp (Mailpit from docker-compose locally: UI on http://localhost:8025),
# resend (production — HTTPS API, since Render blocks outbound SMTP), brevo
# (standalone Brevo transactional API), or routing (Resend first, Brevo
# fallback once Resend's daily cap is hit — JIKU-62, recommended for production
# once both accounts exist: keeps sending past Resend's 100/day free tier
# without paying either provider).
MAIL_TRANSPORT=log

# Sender address for outbound mail. With MAIL_TRANSPORT=resend/brevo/routing it
# must belong to a domain verified with that provider (SPF/DKIM/DMARC records —
# see docs/deploy.md). Production sends from the verified contact.mrvin100.de
# domain; sending from an unverified domain is rejected outright.
MAIL_FROM=no-reply@jiku.app

# Resend HTTPS API key (required when MAIL_TRANSPORT=resend or routing).
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Svix signing secret from the Resend webhook configuration (Dashboard ->
# Webhooks -> endpoint /api/v1/notifications/email-feedback/resend, events
# email.bounced + email.complained). The endpoint rejects everything until set —
# required when MAIL_TRANSPORT=resend.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Brevo transactional API key (required when MAIL_TRANSPORT=brevo or routing).
# Dashboard -> SMTP & API -> API Keys.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# Daily send caps for MAIL_TRANSPORT=routing (JIKU-62). The global cap is kept
# below the sum of the two provider caps on purpose — see EmailRoutingProperties.
# EMAIL_RESEND_DAILY_CAP=100
# EMAIL_BREVO_DAILY_CAP=300
# EMAIL_GLOBAL_DAILY_CAP=350

# ─── Platform administration ─────────────────────────────────────────────────
# First platform administrator (JIKU-40), created idempotently at startup.
# Without it the admin desk (tenants, payments, trials, agreements, audit) is
# unreachable. An existing account is never overwritten; rotate the password
# after first login. (Leave blank only if the deployment has no admin desk use.)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=


# ══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — tuning & feature toggles; defaults shown are safe everywhere
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database tuning ─────────────────────────────────────────────────────────
# Connection pool size — 10 for local, lower for Neon free tier (max ~10 conns).
DATABASE_POOL_SIZE=10

# ─── Server tuning ───────────────────────────────────────────────────────────
# Prefix applied to every REST endpoint (the API version lives here only).
# The frontend's API base URL must point at this same prefix.
SERVER_API_PREFIX=/api/v1

# How the embedded server resolves client IPs behind a reverse proxy
# (native | framework | none). Leave native unless the platform requires otherwise.
SERVER_FORWARDED_HEADERS=native

# ─── Authentication (JWT & recovery) ─────────────────────────────────────────
# Token lifetimes as ISO-8601 durations.
AUTH_JWT_ACCESS_EXPIRATION=PT1H
AUTH_JWT_REFRESH_EXPIRATION=P7D

# How long emailed password-reset / email-verification links stay valid.
AUTH_PASSWORD_RESET_TTL=PT1H
AUTH_EMAIL_VERIFICATION_TTL=P2D

# How long an emailed member invitation stays acceptable.
AUTH_MEMBER_INVITATION_TTL=P7D

# Login brute-force throttle (per IP). Max attempts per time window.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_WINDOW=PT1M

# Google sign-in (JIKU-51): OAuth client id of the Google Identity Services
# button (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID, type
# "Web application"). Must be the SAME value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID: the frontend uses it to obtain the ID token,
# this service uses it to verify the token's audience. No client secret is
# involved. Blank disables the /auth/google endpoint.
# GOOGLE_OAUTH_CLIENT_ID=

# ─── Rate Limiting (public endpoints) ────────────────────────────────────────
# Per-client budgets on every endpoint reachable without an organizer login;
# exceeding one returns 429. Windows are ISO-8601 durations.
RATE_LIMIT_ENABLED=true

# Where counters live: memory (per-instance) or database (shared by every
# instance). MUST be database before this API runs more than one instance — with
# memory, each instance keeps its own counters and every budget below is silently
# multiplied by the number of instances. Single instance: leave it at memory and
# save a database round trip on every public request.
RATE_LIMIT_STORE=memory

# How often elapsed windows are deleted (only used with RATE_LIMIT_STORE=database).
# RATE_LIMIT_SWEEP_CRON=0 */10 * * * *

# Registration + token refresh (per IP).
RATE_LIMIT_AUTH_PUBLIC_MAX_REQUESTS=10
RATE_LIMIT_AUTH_PUBLIC_WINDOW=PT1M

# Guest RSVP and ticket view (per IP + invitation token).
RATE_LIMIT_RSVP_MAX_REQUESTS=30
RATE_LIMIT_RSVP_WINDOW=PT1M

# Validator check-in, search and roster sync (per IP + validator link token).
RATE_LIMIT_CHECKIN_MAX_REQUESTS=120
RATE_LIMIT_CHECKIN_WINDOW=PT1M

# Email provider bounce/complaint webhook (per IP).
RATE_LIMIT_EMAIL_FEEDBACK_MAX_REQUESTS=300
RATE_LIMIT_EMAIL_FEEDBACK_WINDOW=PT1M

# ─── Mail (SMTP transport only) ──────────────────────────────────────────────
# SMTP endpoint for MAIL_TRANSPORT=smtp. Defaults match the Mailpit container.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── WhatsApp (sender) ───────────────────────────────────────────────────────
# Delivery transport: log (default — records sends without delivering) or
# meta (WhatsApp Cloud API). Tenants can override these platform credentials
# with their own in the org settings, so a platform-level value is optional.
WHATSAPP_TRANSPORT=log

# Meta WhatsApp Cloud API credentials for WHATSAPP_TRANSPORT=meta (Meta for
# Developers -> your app -> WhatsApp -> API Setup).
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_BASE_URL=https://graph.facebook.com/v21.0

# Approved message template for business-initiated sends (template approval is
# an external Meta process). Blank sends plain text, which only reaches
# recipients inside the 24h customer-service window (fine for testing).
# WHATSAPP_META_TEMPLATE_NAME=
# WHATSAPP_META_TEMPLATE_LANGUAGE=fr

# Cost/quota/category guardrails (JIKU-61). Sends are queued rather than sent
# once a pool's 24h rolling conversation count reaches this many — a safety
# margin under Meta's hard tier ceiling (250 for an unverified/Tier-1 number).
# WHATSAPP_CONVERSATION_SAFETY_THRESHOLD=220

# Conversion rate used to record WhatsApp message cost in GNF alongside USD.
# WHATSAPP_USD_TO_GNF_RATE=8760

# Comma-separated, case-insensitive substrings that mark a rendered WhatsApp
# body as promotional (MARKETING) rather than transactional (UTILITY) —
# sending promotional content in the UTILITY category risks Meta reclassifying
# (and re-billing) the conversation, or flagging the account.
# WHATSAPP_MARKETING_MARKERS=promo,réduction,solde,gratuit,offre spéciale,cadeau,bon plan,code promo,achetez maintenant

# How often invitations queued by a delivery-capacity guardrail (this one, or
# the email routing quota below) are retried.
# INVITATION_QUEUE_SWEEP_CRON=0 */15 * * * *

# ─── Notifications (delivery & reputation) ───────────────────────────────────
# Delivery attempts before a notification is recorded as permanently failed.
NOTIFICATION_MAX_ATTEMPTS=3

# Sender reputation: rolling window and alert thresholds.
NOTIFICATION_REPUTATION_WINDOW_HOURS=24
NOTIFICATION_BOUNCE_RATE_THRESHOLD=0.05
NOTIFICATION_COMPLAINT_RATE_THRESHOLD=0.005
NOTIFICATION_UNDELIVERABLE_HARD_BOUNCES=2

# Ops email for reputation breach alerts.
# NOTIFICATION_OPS_ALERT_EMAIL=ops@your-domain.example

# Sales mailbox notified of each new activation request; blank keeps requests
# visible only in the admin payments desk.
NOTIFICATION_SALES_EMAIL=

# ─── Invitations (imports & sending) ─────────────────────────────────────────
# Maximum number of guest rows accepted in one CSV upload.
INVITATION_MAX_ROWS=20000

# Maximum file size for a guest CSV import.
INVITATION_MAX_FILE_SIZE=10MB

# Delivery attempts before an invitation is marked permanently FAILED.
INVITATION_MAX_ATTEMPTS=3

# ─── Check-in (validator links) ──────────────────────────────────────────────
# How long a freshly issued validator check-in link stays usable (ISO-8601
# duration). Revocation is immediate and independent of this window.
CHECKIN_VALIDATOR_LINK_VALIDITY=P30D

# ─── Billing (usage metering & concierge payments) ───────────────────────────
# Distinct invited guests allowed cumulatively per tenant account (not per
# event — JIKU-54) before a paid tier is required, over the rolling window
# below, and the currency paid tiers are priced in (GNF — Guinean franc).
BILLING_FREE_TIER_GUESTS=100
BILLING_FREE_TIER_WINDOW=P365D
BILLING_CURRENCY=GNF

# CUSTOM tier pricing (beyond the OR tier's 1,000 guests): per-guest and setup
# fee in USD cents, converted through the GNF rate below. Revisit the rate
# periodically — it is read at request time, not pegged.
BILLING_CUSTOM_PER_GUEST_USD_CENTS=5
BILLING_CUSTOM_SETUP_FEE_USD_CENTS=1500
BILLING_CUSTOM_USD_TO_GNF_RATE=8760

# Manual (concierge) payments: payee details shown to a client requesting a
# paid tier — where to send the prepayment. Blank fields are hidden. Never
# collect client payment credentials.
BILLING_MANUAL_PAYEE_NAME=
BILLING_MANUAL_MOMO_NUMBER=
BILLING_MANUAL_MOMO_OPERATOR=
BILLING_MANUAL_BANK_DETAILS=

# Trial sweep schedule and the lead time for the near-expiry heads-up email
# (ISO-8601 duration).
BILLING_TRIAL_CRON=0 15 * * * *
BILLING_TRIAL_NOTICE_LEAD=P3D

# ─── Invoicing (JIKU-69) ─────────────────────────────────────────────────────
# Accounting-grade invoices, needed to bill a company or a public-sector buyer.
# Numbers are gapless per organization per fiscal year; these prefixes only
# shape the human-readable form (e.g. INV-2026-000001).
# BILLING_INVOICE_PREFIX=INV
# BILLING_CREDIT_NOTE_PREFIX=CN
#
# An invoice is dated by calendar day in its jurisdiction, not by UTC instant.
# BILLING_INVOICE_ISSUE_ZONE=Africa/Conakry
#
# The selling entity as it must appear on the document. SET THESE BEFORE ISSUING
# A REAL INVOICE — the default names no registered company.
# BILLING_SELLER_NAME=
# BILLING_SELLER_ADDRESS=
# BILLING_SELLER_TAX_ID=
#
# Consumption tax is configured per country in application.yaml (billing.invoice.tax),
# not here, because each entry is a label plus a rate. IT SHIPS EMPTY ON PURPOSE:
# Guinea's rate is unconfirmed and the scale plan warns against assuming
# Cameroon's, so a guessed default would put a wrong number on a legal document.
# Until a rate is configured for a country, its invoices show zero tax.

# ─── Booking (deposit reservations) ──────────────────────────────────────────
# The deposit percentage collected up front, how many days before the event
# date the balance falls due, and the IANA timezone used for the pre-filled
# draft event a verified deposit provisions (JIKU-55).
BOOKING_DEPOSIT_RATE=0.30
BOOKING_BALANCE_DUE_DAYS=7
BOOKING_EVENT_TIMEZONE=Africa/Conakry

# Payee details shown on the booking payment instructions page — a distinct
# surface from BILLING_MANUAL_* above even if the underlying accounts match.
BOOKING_PAYEE_NAME=
BOOKING_ORANGE_MONEY_NUMBER=
BOOKING_MTN_MOMO_NUMBER=

# Public booking-flow rate limit (per client IP).
RATE_LIMIT_BOOKING_MAX_REQUESTS=20
RATE_LIMIT_BOOKING_WINDOW=PT1M

# ─── Payment (Mobile Money) ──────────────────────────────────────────────────
# The active provider adapter; "sandbox" makes the full flow work locally.
PAYMENT_PROVIDER=sandbox

# Return URL for the sandbox payment flow.
PAYMENT_SANDBOX_RETURN_URL=http://localhost:3000/billing/return

# ─── Platform administration (schedules) ─────────────────────────────────────
# Daily sweep marking past-end enterprise agreements EXPIRED.
ADMIN_AGREEMENTS_CRON=0 0 4 * * *

# ─── Compliance (data retention) ─────────────────────────────────────────────
# Guest personal data is anonymized this many days after an event's date; the
# organizer dashboard warns notice-days ahead.
COMPLIANCE_RETENTION_DAYS=365
COMPLIANCE_RETENTION_NOTICE_DAYS=30
COMPLIANCE_RETENTION_CRON=0 30 3 * * *

# ─── Observability (monitoring & logging) ────────────────────────────────────
# Which management endpoints are exposed over HTTP. /actuator/health is the
# public uptime probe; metrics/prometheus require authentication.
OBSERVABILITY_ENDPOINTS=health,info,metrics,prometheus

# Whether health component details are shown
# (never | when-authorized | always). Keep when-authorized for production.
OBSERVABILITY_HEALTH_DETAILS=when-authorized
OBSERVABILITY_HEALTH_COMPONENTS=when-authorized

# Emit structured JSON logs in deployed environments. "ecs" is Elastic Common
# Schema. Leave unset for readable console logs locally.
# LOGGING_FORMAT=ecs

# Error-tracking DSN — set once a provider is chosen.
# ERROR_TRACKING_DSN=

# Fail startup when migrations drift from the schema (recommended outside local).
# FLYWAY_VALIDATE_ON_MIGRATE=true

# ─── Error tracking (JIKU-70) ────────────────────────────────────────────────
# Leave ERROR_TRACKING_DSN unset locally: with no DSN the application keeps
# logging unhandled errors and makes no outbound call. Set it per deployed
# environment to report them to the provider instead.
# ERROR_TRACKING_RELEASE must be the same value the frontend publishes as
# NEXT_PUBLIC_ERROR_TRACKING_RELEASE for that deployment, so a backend event and
# the frontend report for the same request line up.
#
# ERROR_TRACKING_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# ERROR_TRACKING_ENVIRONMENT=production
# ERROR_TRACKING_RELEASE=

# ─── Deployment (docker-compose.prod.yml + Caddyfile, JIKU-60) ───────────────
# Read by Caddy, not the application itself — only relevant when deploying the
# production compose stack (see docs/deploy.md). The domain Caddy requests a
# Let's Encrypt certificate for, and the contact address given to Let's Encrypt
# for expiry notices.
# API_DOMAIN=api.jiku.mrvin100.de
# CADDY_EMAIL=ops@jiku.app

# ─── Slot engine (JIKU-85) ───────────────────────────────────────────────────
# Defaults for the fixed-grid slot engine; per-service configuration (JIKU-86)
# will override these later. Grid positions start at midnight in the service's
# timezone and repeat every step-minutes.
# CATALOG_SLOT_STEP_MINUTES=30
# CATALOG_SLOT_DURATION_MINUTES=30
# CATALOG_SLOT_BUFFER_MINUTES=0
# CATALOG_SLOT_MIN_HORIZON_MINUTES=120
# CATALOG_SLOT_HOLD_MINUTES=1440

# ─── Service options (JIKU-86) ────────────────────────────────────────────────
# Defaults for non-grid service options; a service overrides them in service_config.
# CATALOG_SERVICE_CONFIRMATION_MODE=ON_REQUEST
# CATALOG_SERVICE_MAX_HORIZON_DAYS=30
# CATALOG_SERVICE_CANCEL_DEADLINE_HOURS=24
# CATALOG_SERVICE_NO_SHOW_TOLERANCE_MINUTES=10
# CATALOG_SERVICE_WALK_INS_ALLOWED=true
# CATALOG_SERVICE_PAYMENT_MODE=FREE

# ─── Local development only (Docker Compose) ─────────────────────────────────
# These are read by docker-compose.yml, not the application. Ignore in Render.
#
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
