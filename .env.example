# Copy to .env and adjust as needed. The real .env is never committed.
#
# Local development needs NO .env at all: the values below are the defaults
# baked into docker-compose.yml and the `local` Spring profile. This file
# documents every variable and provides the templates for staging/production.

# ── Local PostgreSQL (read by docker-compose.yml) ──────────────────────────
POSTGRES_DB=jiku
POSTGRES_USER=jiku
POSTGRES_PASSWORD=jiku
POSTGRES_PORT=5432

# ── Backend datasource — local profile ────────────────────────────────────
# The `local` profile falls back to these exact values if unset, so they only
# need overriding when the local Postgres is reachable somewhere non-default.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jiku
DB_USERNAME=jiku
DB_PASSWORD=jiku

# Connection pool size (all environments). See application.yaml for rationale.
DB_POOL_MAX_SIZE=10

# ── Backend datasource — staging / production (Neon) ──────────────────────
# Required at startup on these profiles; there are no fallback defaults, so a
# missing value fails fast rather than silently using a wrong database.
# Provide the full JDBC URL including Neon's required sslmode.
# DB_URL=jdbc:postgresql://<endpoint>.neon.tech/<database>?sslmode=require
# DB_USERNAME=<neon-user>
# DB_PASSWORD=<neon-password>

# ── Active profile ─────────────────────────────────────────────────────────
# Unset locally (defaults to `local`). Set explicitly on deploy targets.
# SPRING_PROFILES_ACTIVE=staging
