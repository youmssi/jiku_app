# Copy to .env and adjust as needed. The real .env is never committed.
#
# A fresh clone needs NO .env: the values below are the defaults baked into
# docker-compose.yml and application.yaml. This single file drives BOTH the
# PostgreSQL container and the application, so the two can never drift.

# ── PostgreSQL (shared by docker-compose.yml and the application) ──────────
POSTGRES_DB=jiku
POSTGRES_USER=jiku
POSTGRES_PASSWORD=jiku
POSTGRES_PORT=5432
# Host the application connects to. Locally this is the host-mapped container
# port (localhost); in another environment point it at the real database host.
POSTGRES_HOST=localhost

# Connection pool size (application only). See application.yaml for rationale.
DB_POOL_MAX_SIZE=10

# ── API ────────────────────────────────────────────────────────────────────
# Prefix applied to every REST endpoint (the API version lives here only). The
# frontend's API base URL must point at this same prefix.
API_BASE_PATH=/api/v1

# ── Invitations & email ────────────────────────────────────────────────────
# Frontend base URL used to build guest invitation links.
APP_BASE_URL=http://localhost:3000
# Sender address for outbound invitation mail (set a real one per environment).
NOTIFICATION_EMAIL_FROM=no-reply@jiku.app
# Delivery attempts before a notification is recorded as permanently failed.
NOTIFICATION_MAX_ATTEMPTS=3
# Sender reputation: shared secret for the provider bounce/complaint webhook, the
# rolling window and alert thresholds, and an optional ops address to email on a
# breach. The webhook secret MUST be set to a strong value outside local.
NOTIFICATION_WEBHOOK_SECRET=local-development-webhook-secret
NOTIFICATION_REPUTATION_WINDOW_HOURS=24
NOTIFICATION_BOUNCE_RATE_THRESHOLD=0.05
NOTIFICATION_COMPLAINT_RATE_THRESHOLD=0.005
NOTIFICATION_UNDELIVERABLE_HARD_BOUNCES=2
# NOTIFICATION_OPS_ALERT_EMAIL=ops@your-domain.example
# Delivery attempts before an invitation is marked permanently failed.
INVITATION_MAX_ATTEMPTS=3

# ── Check-in (validator links) ──────────────────────────────────────────────
# How long a freshly issued validator check-in link stays usable (ISO-8601
# duration). Revocation is immediate and independent of this window.
CHECKIN_VALIDATOR_LINK_VALIDITY=P30D

# ── Authentication (JWT) ───────────────────────────────────────────────────
# HMAC signing secret, minimum 32 bytes. The app ships a development default;
# every real environment MUST set this to a long random value.
# JWT_SECRET=<at least 32 random bytes>
# Token lifetimes as ISO-8601 durations (optional; defaults shown).
JWT_ACCESS_EXPIRATION=PT1H
JWT_REFRESH_EXPIRATION=P7D

# ── Rate limiting (public endpoints) ────────────────────────────────────────
# Per-client budgets on every endpoint reachable without an organizer login;
# exceeding one returns 429. application.yaml documents each policy's rationale.
# All optional; defaults shown. Windows are ISO-8601 durations.
RATE_LIMIT_ENABLED=true
# Login brute-force throttle (per IP).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_WINDOW=PT1M
# Registration + token refresh (per IP).
RATE_LIMIT_AUTH_PUBLIC_MAX_REQUESTS=10
RATE_LIMIT_AUTH_PUBLIC_WINDOW=PT1M
# Guest RSVP and ticket view (per IP + invitation token).
RATE_LIMIT_RSVP_MAX_REQUESTS=30
RATE_LIMIT_RSVP_WINDOW=PT1M
# Validator check-in, search and roster sync (per IP + validator link token).
RATE_LIMIT_CHECKIN_MAX_REQUESTS=120
RATE_LIMIT_CHECKIN_WINDOW=PT1M
# Email provider bounce/complaint webhook (per IP).
RATE_LIMIT_EMAIL_FEEDBACK_MAX_REQUESTS=300
RATE_LIMIT_EMAIL_FEEDBACK_WINDOW=PT1M
# How the embedded server resolves client IPs behind a reverse proxy
# (native | framework | none). Leave native unless the platform requires otherwise.
FORWARDED_HEADERS_STRATEGY=native
